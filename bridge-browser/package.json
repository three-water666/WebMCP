{
  "name": "bridge-browser",
  "displayName": "webcode bridge",
  "version": "0.11.2",
  "type": "module",
  "scripts": {
    "predev": "pnpm run build:main-world",
    "dev": "vite",
    "build": "pnpm run build:main-world && tsc && vite build",
    "build:main-world": "vite build --config vite.main-world.config.ts",
    "preview": "vite preview",
    "test": "vite build --config vite.test.config.ts && node node_modules/.cache/runtime-tests/approval_policy.test.js && node node_modules/.cache/runtime-tests/network_capture_runtime.test.js"
  },
  "dependencies": {
    "@webcode/shared": "workspace:*"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.4.0",
    "@types/chrome": "^0.0.260",
    "@types/node": "^20.11.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  }
}
